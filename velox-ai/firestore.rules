rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable, hardened helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    // Owner authorization
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validator blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'credits'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 128
        && data.credits is int && data.credits >= 0
        && (!data.keys().contains('maxCredits') || data.maxCredits is int)
        && (!data.keys().contains('creditsUsed') || data.creditsUsed is int)
        && (!data.keys().contains('totalResponsesGenerated') || data.totalResponsesGenerated is int)
        && (!data.keys().contains('totalPickupsCreated') || data.totalPickupsCreated is int)
        && (!data.keys().contains('displayName') || (data.displayName is string && data.displayName.size() <= 128));
    }

    function isValidLog(data) {
      return data.keys().hasAll(['id', 'type', 'content', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.type is string && (data.type == 'resposta' || data.type == 'cantada')
        && data.content is string && data.content.size() <= 10000
        && (!data.keys().contains('style') || (data.style is string && data.style.size() <= 64))
        && (!data.keys().contains('context') || (data.context is string && data.context.size() <= 1000))
        && (!data.keys().contains('recommendation') || (data.recommendation is string && data.recommendation.size() <= 1000))
        && (!data.keys().contains('levelText') || (data.levelText is string && data.levelText.size() <= 100))
        && (!data.keys().contains('percentage') || (data.percentage is int && data.percentage >= 0 && data.percentage <= 100));
    }

    // Users Collection match block
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
                    && isVerified()
                    && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().uid == request.auth.uid
                    && incoming().email == request.auth.token.email;
                    
      // Updates must validate incoming shape and preserve immutable attributes (uid & email)
      allow update: if isOwner(userId)
                    && isVerified()
                    && isValidUser(incoming())
                    && incoming().uid == existing().uid
                    && incoming().email == existing().email;
                    
      allow delete: if isOwner(userId) && isVerified();

      // Subcollection logs matching
      match /logs/{logId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isVerified()
                      && isValidId(logId)
                      && isValidLog(incoming())
                      && incoming().id == logId;
        allow update, delete: if isOwner(userId) && isVerified();
      }
    }
  }
}
